DOMAIN=yourdomain.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BILLING_BASE_URL=https://api.yourdomain.com
BILLING_ALLOWED_HOSTS=api.yourdomain.com,dash.yourdomain.com
AGENCY_OS_SECRET_KEY=  # REQUIRED: run `python3 -c "import secrets; print(secrets.token_hex(32))"` to generate
# Preferred for production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://agency_os:change-me@db-host:5432/agency_os
# Optional Postgres tuning:
# SQLALCHEMY_POOL_SIZE=10
# SQLALCHEMY_MAX_OVERFLOW=20
# Fallback for local SQLite if DATABASE_URL is not set:
DATABASE_PATH=/app/data/agency_os.db
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mail.zero-human-labs.com
