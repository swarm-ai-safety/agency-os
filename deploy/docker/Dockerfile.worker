FROM python:3.12-slim

WORKDIR /app
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml .
COPY pricing.schema.json .
COPY alembic.ini .
COPY alembic/ alembic/
COPY agency_os/ agency_os/
COPY vendor/ vendor/

RUN pip install --no-cache-dir -e ".[api,llm,metering]" numpy

RUN useradd --create-home appuser
USER appuser

CMD ["python", "-m", "agency_os.worker"]
