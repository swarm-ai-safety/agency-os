FROM python:3.14-slim

WORKDIR /app
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml .
COPY pricing.schema.json .
COPY alembic.ini .
COPY alembic/ alembic/
COPY agency_os/ agency_os/
COPY vendor/ vendor/

RUN pip install --no-cache-dir -e ".[api,llm,metering]" numpy

RUN useradd --create-home appuser
USER appuser

EXPOSE 8000
CMD ["uvicorn", "agency_os.service.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
