# Optional: needed only for gateway LLM features
# ANTHROPIC_API_KEY=replace-me
# Optional: needed only for billing endpoints
# STRIPE_SECRET_KEY=replace-me
# Preferred for production databases:
# DATABASE_URL=postgresql+psycopg://agency_os:change-me@db-host:5432/agency_os
# SQLALCHEMY_POOL_SIZE=10
# SQLALCHEMY_MAX_OVERFLOW=20
# Fallback local SQLite path when DATABASE_URL is unset:
DATABASE_PATH=/var/lib/agency-os/agency_os.db
CORS_ORIGINS=https://zero-human-labs.com
LOG_LEVEL=INFO
LOG_JSON=true
