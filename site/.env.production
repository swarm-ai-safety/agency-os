# Production: cross-origin API (Caddy proxies api.zero-human-labs.com → backend)
NEXT_PUBLIC_API_URL=https://api.zero-human-labs.com
AGENCY_OS_API_URL=

# OIDC dashboard login configuration
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_BRIDGE_SECRET=

# Plausible analytics domain (e.g. zero-human-labs.com). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
